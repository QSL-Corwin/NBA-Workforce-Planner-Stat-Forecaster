            if not np.isnan(dk\_line):  
                max\_delta \= max\_line\_deltas.get(comp\_name, 25\)  
                if dk\_line \> total\_comp \+ max\_delta or dk\_line \> total\_comp \* 1.5:  
                    print(f" \[WARNING\] Suspicious line for {p\_name} {comp\_name} ({dk\_line} vs forecast {total\_comp}) \- blanking.")  
