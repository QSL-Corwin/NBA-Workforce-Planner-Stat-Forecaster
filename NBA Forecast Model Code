            \# NEW: Pick6 Recommendation Logic  
            pick6\_rec \= "Skip"  
            if not np.isnan(dk\_line) and not np.isnan(applied\_factor) and applied\_factor \<= 1.05:  
                mae\_threshold \= CATEGORY\_MAE.get(display\_stat, 5.0) \# Default medium buffer  
