        })  
    long\_df \= pd.DataFrame(records)  
    cols\_to\_round \= \['Q1', 'Q2', 'Q3', 'Q4', 'Total', 'Lower', 'Upper', 'Edge', 'Proj\_Min', 'Min\_Delta', 'Last\_Game\_Delta', 'Forecast\_vs\_Season\_Avg', 'Recency\_vs\_Season'\]  
    long\_df\[cols\_to\_round\] \= long\_df\[cols\_to\_round\].round(1)

    long\_df\['Total'\] \= long\_df\[\['Q1', 'Q2', 'Q3', 'Q4'\]\].sum(axis=1)  
    \# NEW: Sort by descending |Edge| for "Top Picks" view in Sheets  
    long\_df\['Abs\_Edge'\] \= long\_df\['Edge'\].abs()  
    long\_df \= long\_df.sort\_values('Abs\_Edge', ascending=False).drop(columns=\['Abs\_Edge'\])

    return long\_df  
def normalize\_team\_capacity(team\_roster\_df: pd.DataFrame) \-\> pd.DataFrame:  
    total\_forecasted\_minutes \= team\_roster\_df\['raw\_minutes\_forecast'\].sum()  
    print(f" \[CHECK\] Raw Team Demand: {total\_forecasted\_minutes:.1f} mins")  
    if total\_forecasted\_minutes \< MIN\_TEAM\_PROJECTION:  
        print(f" \[ALERT\] Low data capture (\<{MIN\_TEAM\_PROJECTION}). Skipping normalization.")  
        team\_roster\_df\['normalized\_minutes'\] \= team\_roster\_df\['raw\_minutes\_forecast'\]  
    else:  
        utilization\_factor \= TEAM\_CAPACITY\_MINUTES / total\_forecasted\_minutes  
        print(f" \[NOTE\] Adjusting by Factor: {utilization\_factor:.3f}")  
        team\_roster\_df\['normalized\_minutes'\] \= team\_roster\_df\['raw\_minutes\_forecast'\] \* utilization\_factor  
    team\_roster\_df\['min\_delta'\] \= team\_roster\_df\['normalized\_minutes'\] \- team\_roster\_df\['last\_8\_min\_avg'\]  
    team\_roster\_df\['last\_game\_delta'\] \= team\_roster\_df\['normalized\_minutes'\] \- team\_roster\_df\['last\_game\_min'\]  
    return team\_roster\_df  
def apply\_interval\_distribution(team\_roster\_df: pd.DataFrame) \-\> pd.DataFrame:  
    for cat in STAT\_CATEGORIES:  
        display\_name \= "FG3M" if cat \== "fg3m" else cat.upper()  
        q\_cols \= \[f'{display\_name}\_Q{i}' for i in range(1, 5)\]  
        for c in q\_cols:  
            team\_roster\_df\[c\] \= 0.0  
    for idx, row in team\_roster\_df.iterrows():  
        role \= row\['role'\]  
        curve \= ROTATION\_CURVES.get(role, ROTATION\_CURVES\["BENCH"\])

        for cat in STAT\_CATEGORIES:  
            display\_name \= "FG3M" if cat \== "fg3m" else cat.upper()  
            q\_cols \= \[f'{display\_name}\_Q{i}' for i in range(1, 5)\]

            total\_proj \= row\[f'fc\_{cat}'\]

            team\_roster\_df.at\[idx, q\_cols\[0\]\] \= total\_proj \* curve\[0\]  
            team\_roster\_df.at\[idx, q\_cols\[1\]\] \= total\_proj \* curve\[1\]  
            team\_roster\_df.at\[idx, q\_cols\[2\]\] \= total\_proj \* curve\[2\]  
            team\_roster\_df.at\[idx, q\_cols\[3\]\] \= total\_proj \* curve\[3\]  
    return team\_roster\_df  
def process\_player(planner, player, team\_data, opponent):  
    pid \= player\['id'\]  
    p\_name \= f"{player\['first\_name'\]} {player\['last\_name'\]}"

    logs \= planner.get\_player\_stats(pid)

    raw\_mins \= planner.calculate\_raw\_demand(logs)

    if raw\_mins \< 5.0:  
        return None

    last\_8\_min\_avg \= planner.calculate\_simple\_ma(logs, 'minutes\_actual', games\_window=8)

    last\_game\_min \= logs.head(1)\['minutes\_actual'\].item() if not logs.empty else 0.0

    waterfall\_ppm \= planner.calculate\_base\_ppm(logs)

    ma\_ppm \= {}  
    for cat in STAT\_CATEGORIES:  
        ma\_ppm\[cat\] \= planner.calculate\_simple\_ma(logs, f'ppm\_{cat}', games\_window=8)

    season\_ppm \= {}  
    for cat in STAT\_CATEGORIES:  
        season\_ppm\[cat\] \= planner.calculate\_season\_baseline(logs, f'ppm\_{cat}')

    w\_weight \= 0.60  
    m\_weight \= 0.20  
    s\_weight \= 0.20

    blended\_ppm \= {}

    for cat in STAT\_CATEGORIES:  
        w\_val \= waterfall\_ppm.get(cat, 0.0)  
        m\_val \= ma\_ppm.get(cat, 0.0)  
        s\_val \= season\_ppm.get(cat, 0.0)

        blended\_ppm\[cat\] \= (w\_val \* w\_weight) \+ (m\_val \* m\_weight) \+ (s\_val \* s\_weight)  
    role \= planner.determine\_role(raw\_mins)

    player\_data \= {  
        "player\_id": pid,  
        "player\_name": p\_name,  
        "position": player.get("position", "N/A"), \# Extract position from player dict  
        "team": team\_data\['abbreviation'\],  
        "opponent": opponent,  
        "role": role,  
        "raw\_minutes\_forecast": raw\_mins,  
        "last\_8\_min\_avg": last\_8\_min\_avg,  
        "last\_game\_min": last\_game\_min,  
    }

    for cat, val in blended\_ppm.items():  
        player\_data\[f"ppm\_{cat}"\] \= val

    return player\_data  
def run\_workforce\_forecast() \-\> pd.DataFrame:  
    planner \= NBAWorkforcePlanner(API\_KEY)  
    global\_start \= time.time()  
    print(f"Using season: {CURRENT\_SEASON}")  
    schedule\_df \= planner.get\_games\_today()  
    if schedule\_df.empty:  
        print("No games scheduled.")  
        return pd.DataFrame()  
    game\_ids \= schedule\_df\['id'\].tolist()

    planner.fetch\_player\_props\_v2(game\_ids)  
    team\_ids\_in\_play \= set(schedule\_df\['home\_team'\].apply(lambda x: x\['id'\]).tolist() \+  
                           schedule\_df\['visitor\_team'\].apply(lambda x: x\['id'\]).tolist())

    dynamic\_factors\_map, pace\_map \= planner.generate\_dynamic\_opponent\_factors(list(team\_ids\_in\_play))  
    all\_forecasts \= \[\]  
    for idx, game in schedule\_df.iterrows():  
        home\_team \= game\['home\_team'\]  
        visitor\_team \= game\['visitor\_team'\]  
        print(f"\\n=== MATCHUP: {visitor\_team\['abbreviation'\]} @ {home\_team\['abbreviation'\]} \===")  
        for team\_data, \_, opponent in \[(home\_team, True, visitor\_team\['abbreviation'\]),  
                                       (visitor\_team, False, home\_team\['abbreviation'\])\]:  
            print(f"\> Processing {team\_data\['abbreviation'\]}")  
            roster \= planner.get\_active\_rotation(team\_data\['id'\])  
            if not roster:  
                print(f" \[SKIP\] No active rotation found for {team\_data\['abbreviation'\]}")  
                continue  
            team\_forecasts \= \[\]  
            with concurrent.futures.ThreadPoolExecutor(max\_workers=MAX\_WORKERS) as executor:  
                futures \= {executor.submit(process\_player, planner, player, team\_data, opponent): player for player in roster}  
                for future in concurrent.futures.as\_completed(futures):  
                    result \= future.result()  
                    if result:  
                        team\_forecasts.append(result)  
            print(f" \[DEBUG\] Processed players: {len(team\_forecasts)}")  
            if not team\_forecasts:  
                continue  
            team\_df \= pd.DataFrame(team\_forecasts)  
            team\_df \= normalize\_team\_capacity(team\_df)

            opp\_factors \= dynamic\_factors\_map.get(opponent, {})  
            opp\_pace \= pace\_map.get(opponent, LEAGUE\_AVG\_PACE)  
            pace\_scalar \= opp\_pace / LEAGUE\_AVG\_PACE  
            for cat in STAT\_CATEGORIES:  
                factor \= opp\_factors.get(cat, 1.0)  
                team\_df\[f'factor\_{cat}'\] \= factor  
                team\_df\[f'fc\_{cat}'\] \= team\_df\['normalized\_minutes'\] \* team\_df\[f'ppm\_{cat}'\] \* factor \* pace\_scalar  
            team\_df \= apply\_interval\_distribution(team\_df)  
            all\_forecasts.append(team\_df)  
    elapsed\_total \= time.time() \- global\_start  
    print(f"\\nEXECUTION COMPLETE: {elapsed\_total:.2f}s | Total requests: {planner.request\_count}")  
    if all\_forecasts:  
        raw\_final\_df \= pd.concat(all\_forecasts, ignore\_index=True)  
        formatted\_df \= reshape\_forecast\_payload(raw\_final\_df, planner)  
        return formatted\_df  
    return pd.DataFrame()  
