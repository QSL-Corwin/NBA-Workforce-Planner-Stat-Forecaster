            \# NEW: Pick6 Recommendation Logic (for composites, Opponent\_Factor is NaN, so skip)  
            pick6\_rec \= "Skip"  
            if not np.isnan(dk\_line) and not np.isnan(applied\_factor) and applied\_factor \<= 1.05:  
                mae\_threshold \= CATEGORY\_MAE.get(comp\_name, 5.0) \# Default medium buffer  
                if abs(edge) \> mae\_threshold:  
                    if total\_comp \> dk\_line:  
                        pick6\_rec \= "More"  
                    else:  
                        pick6\_rec \= "Less"  
            records.append({  
                'player\_name': p\_name,  
                'position': row\['position'\],  
                'team': row\['team'\],  
                'Opponent': row\['opponent'\],  
                'Opponent\_Factor': np.nan,  
                'Stat': comp\_name,  
                'Q1': comp\_q\_vals\[0\],  
                'Q2': comp\_q\_vals\[1\],  
                'Q3': comp\_q\_vals\[2\],  
                'Q4': comp\_q\_vals\[3\],  
                'Total': total\_comp,  
                'Lower': lower,  
                'Upper': upper,  
                'Line': dk\_line,  
                'Edge': edge,  
                'Proj\_Min': round(proj\_min, 1),  
                'Min\_Delta': round(min\_delta, 1),  
                'Last\_Game\_Delta': round(last\_game\_delta, 1),  
