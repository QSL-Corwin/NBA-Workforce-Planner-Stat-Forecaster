            forecast\_vs\_season \= round(forecast\_vs\_season\_comp, 1\) if count\_ing \> 0 else np.nan  
            recency\_vs\_season\_comp \= 0.0  
            for ing in ingredients:  
                ing\_code \= {'PTS': 'pts', 'REB': 'reb', 'AST': 'ast'}.get(ing, 'pts')  
                waterfall\_ppm \= planner.calculate\_waterfall\_metric(logs, f'ppm\_{ing\_code}')  
                ma\_ppm \= planner.calculate\_simple\_ma(logs, f'ppm\_{ing\_code}')  
                waterfall\_ing\_total \= waterfall\_ppm \* proj\_min  
                ma\_ing\_total \= ma\_ppm \* proj\_min  
                recency\_vs\_season\_comp \+= ((waterfall\_ing\_total \- season\_avg\_ing\_total) \+ (ma\_ing\_total \- season\_avg\_ing\_total)) / 2  
            recency\_vs\_season \= round(recency\_vs\_season\_comp, 1\) if count\_ing \> 0 else np.nan  
            \# Approximate std for composite (sum of recent component stds)  
            comp\_std \= sum(player\_base\_stds.get(ing, 0.0) for ing in ingredients)  
            if sparse\_data:  
                comp\_std \= 2.0 \* len(ingredients) \# Scaled default  
            lower \= max(0, total\_comp \- comp\_std)  
            upper \= total\_comp \+ comp\_std  
            story \= "Balanced projection – monitor lineup/news"  
            if not np.isnan(dk\_line):  
                if edge \>= 2.0 and min\_delta \>= 1.5 and forecast\_vs\_season \>= 2.0:  
                    story \= "Strong over candidate – hot recency \+ expanded role \+ above season norm"  
