def reshape\_forecast\_payload(df: pd.DataFrame, planner: NBAWorkforcePlanner) \-\> pd.DataFrame:  
    records \= \[\]  
    base\_stats\_map \= {  
        'PTS': 'pts', 'AST': 'ast', 'REB': 'reb',  
        'STL': 'stl', 'BLK': 'blk', 'FG3M': 'fg3m'  
    }  
    max\_line\_deltas \= {  
        'PTS': 15,  
        'REB': 8,  
        'AST': 8,  
        'FG3M': 5,  
        'BLK': 5,  
        'STL': 5,  
        'PRA': 20,  
        'PR': 18,  
        'PA': 18,  
        'RA': 12  
    }  
    RECENT\_WINDOW \= 3 \# UPDATED: Switched to last 3 games per your suggestion for tighter ranges  
    for \_, row in df.iterrows():  
        p\_name \= row\['player\_name'\]  
        pid \= row\['player\_id'\]  
        role \= row\['role'\]  
        proj\_min \= row.get('normalized\_minutes', np.nan)  
        min\_delta \= row.get('min\_delta', np.nan)  
        last\_game\_delta \= row.get('last\_game\_delta', np.nan)  
        player\_base\_qs \= {}  
        player\_base\_stds \= {} \# Store stds for base stats  
        logs \= planner.get\_player\_stats(pid)  
        df\_played \= logs\[logs\['minutes\_actual'\] \> 0\] \# Full season played  
        sparse\_data \= len(df\_played) \< MIN\_SAMPLE\_SIZE \# Flag for default  
        \# 1\. Base Stats  
        for display\_stat, internal\_code in base\_stats\_map.items():  
            q\_vals \= \[row.get(f'{display\_stat}\_Q{i}', 0.0) for i in range(1, 5)\]  
            total \= sum(q\_vals)  
            player\_base\_qs\[display\_stat\] \= q\_vals  
            \# Use std from recent games for tighter range  
            recent\_logs \= df\_played.head(RECENT\_WINDOW)  
            if len(recent\_logs) \>= 3: \# Require at least 3 for this tight window  
                stat\_std \= recent\_logs\[internal\_code\].std()  
            elif len(recent\_logs) \>= MIN\_SAMPLE\_SIZE:  
                stat\_std \= recent\_logs\[internal\_code\].std()  
            elif not df\_played.empty and not sparse\_data:  
                stat\_std \= df\_played\[internal\_code\].std()  
            else:  
                stat\_std \= 2.0 \# Default buffer  
            player\_base\_stds\[display\_stat\] \= stat\_std  
            dk\_line \= planner.betting\_lines\_cache.get((pid, display\_stat), np.nan)  
            applied\_factor \= row.get(f'factor\_{internal\_code}', 1.0)  
            edge \= round(total \- dk\_line, 1\) if not np.isnan(dk\_line) else np.nan  
            if not np.isnan(dk\_line):  
                max\_delta \= max\_line\_deltas.get(display\_stat, 20\)  
                if dk\_line \> total \+ max\_delta or dk\_line \> total \* 1.5:  
                    print(f" \[WARNING\] Suspicious line for {p\_name} {display\_stat} ({dk\_line} vs forecast {total}) \- blanking.")  
                    dk\_line \= np.nan  
                    edge \= np.nan  
            season\_avg\_total \= planner.calculate\_season\_baseline(logs, internal\_code)  
            if display\_stat \== 'PTS':  
                print(f"\[DEBUG\] For {p\_name} PTS: projected total \= {total}, season\_avg\_total \= {season\_avg\_total}")  
            forecast\_vs\_season \= round(total \- season\_avg\_total, 1\) if season\_avg\_total \> 0 else np.nan  
            waterfall\_ppm \= planner.calculate\_waterfall\_metric(logs, f'ppm\_{internal\_code}')  
            ma\_ppm \= planner.calculate\_simple\_ma(logs, f'ppm\_{internal\_code}')  
            waterfall\_total \= waterfall\_ppm \* proj\_min  
            ma\_total \= ma\_ppm \* proj\_min  
            recency\_vs\_season \= round(((waterfall\_total \- season\_avg\_total) \+ (ma\_total \- season\_avg\_total)) / 2, 1\) if season\_avg\_total \> 0 else np.nan  
            if display\_stat \== 'PTS':  
                print(f"\[DEBUG\] For {p\_name} PTS: Forecast\_vs\_Season\_Avg \= {forecast\_vs\_season}")  
            story \= "Balanced projection – monitor lineup/news"  
            if not np.isnan(dk\_line):  
                if edge \>= 2.0 and min\_delta \>= 1.5 and forecast\_vs\_season \>= 2.0:  
