        lower \= max(0, total\_dkfp \- dkfp\_std)  
        upper \= total\_dkfp \+ dkfp\_std  
        \# NEW: Pick6 Recommendation Logic (no line, so always Skip)  
        pick6\_rec \= "Skip"  
        records.append({  
