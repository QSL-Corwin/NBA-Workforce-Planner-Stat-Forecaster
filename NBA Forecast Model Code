                    edge \= np.nan  
            forecast\_vs\_season\_comp \= 0.0  
            count\_ing \= 0  
            for ing in ingredients:  
                ing\_code \= {'PTS': 'pts', 'REB': 'reb', 'AST': 'ast'}.get(ing, 'pts')  
                logs \= planner.get\_player\_stats(pid)  
                season\_avg\_ing\_total \= planner.calculate\_season\_baseline(logs, ing\_code)  
                ing\_total \= player\_base\_qs\[ing\]\[0\] \+ player\_base\_qs\[ing\]\[1\] \+ player\_base\_qs\[ing\]\[2\] \+ player\_base\_qs\[ing\]\[3\]  
