class NBAWorkforcePlanner:  
    def \_\_init\_\_(self, api\_key: str):  
        self.headers \= {"Authorization": api\_key}  
        self.player\_logs\_cache: Dict\[int, pd.DataFrame\] \= {}  
        self.session \= requests.Session()  
        self.session.headers.update(self.headers)  
        self.request\_count \= 0  
        \# Cache key: (player\_id, stat\_type\_UPPERCASE) \-\> line value  
        self.betting\_lines\_cache: Dict\[tuple, float\] \= {}  
    def \_get\_full\_response(self, endpoint: str, params: Optional\[Dict\] \= None) \-\> Dict:  
        """Returns full JSON response (including meta for pagination)."""  
        self.request\_count \+= 1  
        url \= endpoint if endpoint.startswith("http") else f"{BASE\_URL}/{endpoint}"

        for attempt in range(3):  
            try:  
                resp \= self.session.get(url, params=params)  
                if resp.status\_code \== 429:  
                    sleep\_time \= 2 \*\* attempt  
                    print(f" \[429\] Rate limit hit. Sleeping {sleep\_time}s...")  
                    time.sleep(sleep\_time)  
                    continue  
                resp.raise\_for\_status()  
                return resp.json()  
            except requests.exceptions.RequestException as e:  
                print(f"API Error \[{endpoint}\]: {e}")  
                return {"data": \[\], "meta": {}}  
        return {"data": \[\], "meta": {}}  
    def \_get\_data(self, endpoint: str, params: Optional\[Dict\] \= None) \-\> List\[Dict\]:  
        """Convenience for just data."""  
        return self.\_get\_full\_response(endpoint, params).get("data", \[\])  
    def get\_games\_today(self, date\_str: Optional\[str\] \= None) \-\> pd.DataFrame:  
        if not date\_str:  
            date\_str \= datetime.now().strftime('%Y-%m-%d')  
        print(f"--- Fetching Schedule for {date\_str} \---")  
        games \= self.\_get\_data("games", {"dates\[\]": date\_str})  
        return pd.DataFrame(games)  
    def get\_team\_injuries(self, team\_id: int) \-\> set:  
        """  
        Fetches current injuries for a team and returns a set of player IDs marked as 'Out'.  
        Like checking the pre-game injury list to avoid projecting unavailable players.  
        """  
        print(f" \[DEBUG\] Fetching injuries for team {team\_id}")  
        params \= {"team\_ids\[\]": team\_id}  
        injuries \= self.\_get\_data("player\_injuries", params)

        out\_players \= set()  
        for injury in injuries:  
            if injury.get('status') \== 'Out': \# Assuming 'status' field; confirm via API test if needed  
                player \= injury.get('player', {})  
                pid \= player.get('id')  
                if pid:  
                    out\_players.add(pid)  
                    print(f" \[INJURY\] Excluding {player.get('first\_name', '')} {player.get('last\_name', '')} (Out: {injury.get('comment', 'N/A')})")

        return out\_players  
    def get\_active\_rotation(self, team\_id: int) \-\> List\[Dict\]:  
        params \= {"team\_ids\[\]": team\_id, "seasons\[\]": CURRENT\_SEASON, "per\_page": 20, "status": "Final"}  
        games\_data \= self.\_get\_data("games", params)  
        game\_ids \= \[g\['id'\] for g in games\_data\]  
        if not game\_ids:  
            print(f" \[DEBUG\] No recent games found for team {team\_id}")  
            return \[\]  
        all\_stats \= \[\]  
        cursor \= None  
        while True:  
            params \= {"game\_ids\[\]": game\_ids, "per\_page": 100}  
            if cursor:  
                params\['cursor'\] \= cursor  
            payload \= self.\_get\_full\_response("stats", params)  
            data \= payload.get("data", \[\])  
            all\_stats.extend(data)  
            meta \= payload.get("meta", {})  
            cursor \= meta.get("next\_cursor")  
            if not cursor or not data:  
                break  
        print(f" \[DEBUG\] Fetched {len(all\_stats)} stats rows from {len(game\_ids)} recent games for team {team\_id}")  
        player\_minutes, player\_info \= {}, {}  
        for row in all\_stats:  
            row\_team \= row.get('team')  
            if not row\_team or row\_team.get('id') \!= team\_id:  
                continue  
            p \= row.get('player')  
            if not p:  
                continue  
            pid \= p\['id'\]  
            min\_str \= str(row.get('min', '0'))  
            min\_val \= 0.0  
            try:  
                if ':' in min\_str:  
                    parts \= min\_str.split(':')  
                    min\_val \= int(parts\[0\]) \+ int(parts\[1\]) / 60  
                else:  
                    min\_val \= float(min\_str)  
            except:  
                min\_val \= 0.0  
            if min\_val \> 0:  
                player\_minutes\[pid\] \= player\_minutes.get(pid, 0.0) \+ min\_val  
                player\_info\[pid\] \= p  
        sorted\_pids \= sorted(player\_minutes, key=player\_minutes.get, reverse=True)\[:MAX\_ROSTER\_SIZE\]  
        roster \= \[player\_info\[pid\] for pid in sorted\_pids\]  
        print(f" \[DEBUG\] Pre-injury active roster size: {len(roster)}")

        \# NEW: Fetch injuries and filter out 'Out' players  
        injured\_pids \= self.get\_team\_injuries(team\_id)  
        filtered\_roster \= \[p for p in roster if p\['id'\] not in injured\_pids\]

        print(f" \[DEBUG\] Post-injury active roster size: {len(filtered\_roster)}")  
        return filtered\_roster  
    def generate\_dynamic\_opponent\_factors(self, team\_ids: List\[int\]) \-\> Dict\[str, Dict\[str, float\]\]:  
        print(f"\\n--- Generating Category-Specific Opponent Factors \---")  
        opponent\_factors \= {}  
        pace\_map \= {}  
        def fetch\_team\_defense\_splits(tid):  
            \# Fetch ALL finalized games for the team this season with pagination  
            all\_games \= \[\]  
            page \= 1  
            while True:  
                params \= {"team\_ids\[\]": tid, "seasons\[\]": CURRENT\_SEASON, "per\_page": 100, "page": page, "status": "Final"}  
                payload \= self.\_get\_full\_response("games", params)  
                data \= payload.get("data", \[\])  
                all\_games.extend(data)  
                meta \= payload.get("meta", {})  
                if page \>= meta.get("total\_pages", 1):  
                    break  
                page \+= 1  
            if not all\_games:  
                return None

            \# Sort games by date descending (most recent first)  
            all\_games \= sorted(all\_games, key=lambda x: x.get('date', '1900-01-01'), reverse=True)  
            game\_ids \= \[g\['id'\] for g in all\_games\]  
            last5\_game\_ids \= \[g\['id'\] for g in all\_games\[:5\]\] \# Last 5 games

            if not game\_ids:  
                return None

            allowed\_stats\_season \= {k: \[\] for k in LEAGUE\_AVGS.keys()}  
            allowed\_stats\_last5 \= {k: \[\] for k in LEAGUE\_AVGS.keys()}

            all\_stats \= \[\]  
            cursor \= None  
            while True:  
                s\_params \= {"game\_ids\[\]": game\_ids, "per\_page": 100}  
                if cursor: s\_params\['cursor'\] \= cursor  
                payload \= self.\_get\_full\_response("stats", s\_params)  
                data \= payload.get("data", \[\])  
                all\_stats.extend(data)  
                meta \= payload.get("meta", {})  
                cursor \= meta.get("next\_cursor")  
                if not cursor or not data:  
                    break

            games\_map \= {}  
            for row in all\_stats:  
                gid \= row\['game'\]\['id'\]  
                if gid not in games\_map: games\_map\[gid\] \= \[\]  
                games\_map\[gid\].append(row)

            pace\_season \= \[\]  
            pace\_last5 \= \[\]  
            for gid, rows in games\_map.items():  
                game\_totals \= {k: 0.0 for k in LEAGUE\_AVGS.keys()}  
                team\_totals \= {'fga': 0, 'fta': 0, 'oreb': 0, 'turnover': 0}  
                for row in rows:  
                    if row\['team'\]\['id'\] \!= tid:  
                        for cat in LEAGUE\_AVGS.keys():  
                            val \= row.get(cat, 0\)  
                            if val: game\_totals\[cat\] \+= val  
                    else:  
                        team\_totals\['fga'\] \+= row.get('fga', 0\)  
                        team\_totals\['fta'\] \+= row.get('fta', 0\)  
                        team\_totals\['oreb'\] \+= row.get('oreb', 0\)  
                        team\_totals\['turnover'\] \+= row.get('turnover', 0\)

                team\_poss \= (team\_totals\['fga'\] \+ 0.4 \* team\_totals\['fta'\] \-  
                             team\_totals\['oreb'\] \+ team\_totals\['turnover'\])  
                pace\_season.append(team\_poss)  
                if gid in last5\_game\_ids:  
                    pace\_last5.append(team\_poss)

                for cat in LEAGUE\_AVGS.keys():  
                    allowed\_stats\_season\[cat\].append(game\_totals\[cat\])  
                    if gid in last5\_game\_ids:  
                        allowed\_stats\_last5\[cat\].append(game\_totals\[cat\])

            \# Pace calculation  
            if pace\_season:  
                season\_pace \= np.mean(pace\_season)  
            else:  
                season\_pace \= LEAGUE\_AVG\_PACE

            if pace\_last5 and len(pace\_last5) \>= 3:  
                last5\_pace \= np.mean(pace\_last5)  
            else:  
                last5\_pace \= season\_pace

            blended\_pace \= 0.5 \* season\_pace \+ 0.5 \* last5\_pace

            team\_factors \= {}  
            for cat in LEAGUE\_AVGS.keys():  
                season\_vals \= allowed\_stats\_season\[cat\]  
                last5\_vals \= allowed\_stats\_last5\[cat\]

                if season\_vals:  
                    season\_avg \= np.mean(season\_vals)  
                else:  
                    season\_avg \= LEAGUE\_AVGS.get(cat, 10.0)

                if last5\_vals and len(last5\_vals) \>= 3: \# Min 3 for reliability  
                    last5\_avg \= np.mean(last5\_vals)  
                else:  
                    last5\_avg \= season\_avg

                blended\_avg \= 0.5 \* season\_avg \+ 0.5 \* last5\_avg  
                league\_base \= LEAGUE\_AVGS.get(cat, 10.0)  
                factor \= blended\_avg / league\_base  
                team\_factors\[cat\] \= max(0.75, min(1.35, factor))

            abbr \= ""  
            for g in all\_games:  
                if g\['home\_team'\]\['id'\] \== tid: abbr \= g\['home\_team'\]\['abbreviation'\]  
                else: abbr \= g\['visitor\_team'\]\['abbreviation'\]  
                break

            return abbr, team\_factors, blended\_pace  
        with concurrent.futures.ThreadPoolExecutor(max\_workers=MAX\_WORKERS) as executor:  
            futures \= {executor.submit(fetch\_team\_defense\_splits, tid): tid for tid in team\_ids}  
            for future in concurrent.futures.as\_completed(futures):  
                try:  
                    result \= future.result()  
                    if result:  
                        abbr, factors, pace \= result  
                        opponent\_factors\[abbr\] \= factors  
                        pace\_map\[abbr\] \= pace  
                except Exception:  
                    pass  
        return opponent\_factors, pace\_map  
    def get\_player\_stats(self, player\_id: int) \-\> pd.DataFrame:  
        if player\_id in self.player\_logs\_cache:  
            return self.player\_logs\_cache\[player\_id\]  
        params \= {"player\_ids\[\]": player\_id, "seasons\[\]": CURRENT\_SEASON, "per\_page": 100}  
        data \= self.\_get\_data("stats", params)  
        df \= pd.DataFrame(data)  
        if not df.empty:  
            def clean\_min(m):  
                if pd.isna(m):  
                    return 0.0  
                s \= str(m).strip()  
                try:  
                    return int(s.split(':')\[0\]) \+ int(s.split(':')\[1\])/60 if ':' in s else float(s)  
                except:  
                    return 0.0  
            df\['minutes\_actual'\] \= df\['min'\].apply(clean\_min)  
            df\['minutes\_trend'\] \= df\['minutes\_actual'\].clip(upper=48.0)  
            for cat in STAT\_CATEGORIES:  
                col \= cat  
                if col not in df.columns:  
                    df\[col\] \= 0.0  
                else:  
                    df\[col\] \= df\[col\].fillna(0)  
                df\[f'ppm\_{cat}'\] \= np.where(df\['minutes\_actual'\] \> 0, df\[col\] / df\['minutes\_actual'\], 0\)  
            if 'game' in df.columns:  
                df\['date\_sort'\] \= df\['game'\].apply(lambda x: x.get('date') if x else '1900-01-01')  
            df \= df.sort\_values('date\_sort', ascending=False)  
        self.player\_logs\_cache\[player\_id\] \= df  
        return df  
    def calculate\_waterfall\_metric(self, df\_logs: pd.DataFrame, col\_name: str) \-\> float:  
        if df\_logs.empty:  
            return 0.0  
        weighted\_sum \= 0.0  
        total\_weight \= 0.0  
        for config in WATERFALL\_CONFIG.values():  
            subset \= df\_logs.head(config\['limit'\])  
            if not subset.empty:  
                val \= subset\[col\_name\].mean()  
                if pd.notna(val):  
                    weighted\_sum \+= val \* config\['weight'\]  
                    total\_weight \+= config\['weight'\]  
        return float(weighted\_sum / total\_weight) if total\_weight \> 0 else 0.0  
    def calculate\_simple\_ma(self, df\_logs: pd.DataFrame, col\_name: str, games\_window: int \= 8\) \-\> float:  
        if df\_logs.empty: return 0.0  
        subset \= df\_logs.head(games\_window)  
        if subset.empty: return 0.0  
        val \= subset\[col\_name\].mean()  
        return float(val) if pd.notna(val) else 0.0  
    def calculate\_season\_baseline(self, df\_logs: pd.DataFrame, col\_name: str) \-\> float:  
        if df\_logs.empty or len(df\_logs) \< MIN\_SAMPLE\_SIZE:  
            print(f"\[DEBUG\] Sparse logs ({len(df\_logs)} games) for {col\_name} \- returning 0.0 baseline")  
            return 0.0  
        \# UPDATED: Filter to played games only (exclude DNPs/inactives with 0 minutes)  
        df\_played \= df\_logs\[df\_logs\['minutes\_actual'\] \> 0\]  
        if df\_played.empty:  
            print(f"\[DEBUG\] No played games found for {col\_name} \- returning 0.0")  
            return 0.0  
        val \= df\_played\[col\_name\].mean()  
        print(f"\[DEBUG\] Season baseline for {col\_name}: {val:.1f} from {len(df\_played)} played games")  
        return float(val) if pd.notna(val) else 0.0  
    def calculate\_raw\_demand(self, df\_logs: pd.DataFrame) \-\> float:  
        if df\_logs.empty or len(df\_logs) \< MIN\_SAMPLE\_SIZE:  
            return 0.0  
        return self.calculate\_waterfall\_metric(df\_logs, 'minutes\_trend')  
    def calculate\_base\_ppm(self, df\_logs: pd.DataFrame) \-\> Dict\[str, float\]:  
        if df\_logs.empty:  
            return {cat: 0.0 for cat in STAT\_CATEGORIES}  
        return {cat: self.calculate\_waterfall\_metric(df\_logs, f'ppm\_{cat}') for cat in STAT\_CATEGORIES}  
    def determine\_role(self, expected\_minutes: float) \-\> str:  
        if expected\_minutes \>= 28.0:  
            return "STARTER"  
        elif expected\_minutes \>= 20.0:  
            return "ROTATION"  
        else:  
            return "BENCH"  
    def fetch\_player\_props\_v2(self, game\_ids: List\[int\]):  
        print(f"\\n--- Fetching GOAT Tier Betting Lines (v2) for {len(game\_ids)} Games \---")  
        self.betting\_lines\_cache \= {}  
        prop\_map \= {  
            'points': 'PTS',  
            'rebounds': 'REB',  
            'assists': 'AST',  
            'threes': 'FG3M',  
            'blocks': 'BLK',  
            'steals': 'STL',  
            'points\_rebounds\_assists': 'PRA',  
            'points\_rebounds': 'PR',  
            'points\_assists': 'PA',  
            'rebounds\_assists': 'RA'  
        }  
        line\_caps \= {  
            'PTS': 50, 'REB': 20, 'AST': 20,  
            'FG3M': 10, 'BLK': 10, 'STL': 10,  
            'PRA': 70, 'PR': 50, 'PA': 50, 'RA': 35  
        }  
        url \= "https://api.balldontlie.io/nba/v2/odds/player\_props"  
        for gid in game\_ids:  
            params \= {"game\_id": gid, "book": "draftkings"}  
            payload \= self.\_get\_full\_response(url, params)  
            data \= payload.get("data", \[\])  
            count \= 0  
            for prop in data:  
                prop\_type \= prop.get('prop\_type')  
                if prop\_type not in prop\_map:  
                    continue  
                line \= prop.get('line\_value')  
                pid \= prop.get('player\_id')  
                if line and pid:  
                    stat\_key \= prop\_map\[prop\_type\]  
                    line\_val \= float(line)  
                    cap \= line\_caps.get(stat\_key, 100\)  
                    if line\_val \> cap:  
                        print(f" \[WARNING\] Invalid line for {stat\_key} ({line\_val} \> {cap}) in game {gid} \- skipping.")  
                        continue  
                    self.betting\_lines\_cache\[(pid, stat\_key)\] \= line\_val  
                    count \+= 1  
            print(f" \> Game {gid}: Cached {count} prop lines.")  
